{
  "name": "openround-desktop",
  "productName": "OpenRound",
  "version": "1.1.0",
  "description": "Drift round blast design and perimeter damage analysis",
  "author": "OpenRound contributors",
  "license": "MIT",
  "main": "main.js",
  "homepage": "https://github.com/furkankasa/openround",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "io.github.furkankasa.openround",
    "productName": "OpenRound",
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "OpenRound-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "OpenRound-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OpenRound"
    },
    "compression": "maximum"
  }
}